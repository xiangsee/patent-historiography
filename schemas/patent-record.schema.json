{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patent historical evidence record",
  "description": "One traceable patent document; family and ownership are time-dependent, not flattened.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patent_record_id",
    "publication_number",
    "source_ids",
    "retrieved_at",
    "attribution_type"
  ],
  "properties": {
    "patent_record_id": {
      "type": "string",
      "minLength": 1
    },
    "publication_number": {
      "type": "string",
      "minLength": 1
    },
    "application_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "simple_family_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "extended_family_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "jurisdiction": {
      "type": [
        "string",
        "null"
      ]
    },
    "priority_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "filing_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "publication_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "grant_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "original_assignee_entity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inventor_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cpc_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attribution_type": {
      "enum": [
        "originated",
        "acquired",
        "assigned",
        "licensed",
        "joint",
        "unresolved"
      ]
    },
    "attribution_as_of": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_dataset_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date"
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
