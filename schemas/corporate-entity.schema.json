{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Corporate historical entity ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity_id",
    "legal_name",
    "jurisdiction",
    "source_ids",
    "verification_status"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "legal_name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "jurisdiction": {
      "type": "string"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "parent_entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "relationship_type": {
      "enum": [
        "parent",
        "subsidiary",
        "acquired",
        "merged",
        "spun_out",
        "licensed_counterparty",
        "independent",
        "unknown"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "verification_status": {
      "enum": [
        "unverified",
        "provisional",
        "cross_checked"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
