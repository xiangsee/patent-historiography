{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multi-axis historical event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "date_text",
    "date_precision",
    "axis",
    "summary",
    "source_ids",
    "status"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "date_text": {
      "type": "string",
      "minLength": 1
    },
    "date_precision": {
      "enum": [
        "day",
        "month",
        "year",
        "interval",
        "unknown"
      ]
    },
    "axis": {
      "enum": [
        "technology",
        "product",
        "organization",
        "industry",
        "institution",
        "patent_rights"
      ]
    },
    "subject_entity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knowledge_as_of_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "status": {
      "enum": [
        "verified",
        "provisional",
        "disputed"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "date_as_reported": {
      "type": [
        "string",
        "null"
      ],
      "description": "Source's original date expression, never overwritten by normalization"
    },
    "date_normalized": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Normalized date; if unavailable use null and retain original"
    },
    "calendar_system": {
      "type": [
        "string",
        "null"
      ],
      "description": "Named original or modern calendar or unknown"
    },
    "period_scope_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Research window and beginning/ending event; distinct scopes can coexist"
    },
    "temporal_granularity": {
      "enum": [
        "day",
        "month",
        "quarter",
        "year",
        "mixed",
        "unknown"
      ]
    },
    "narrative_anchor_entity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Whose chronology/point of view does this original account privilege?"
    },
    "conversion_rule_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_layer": {
      "enum": [
        "original_document",
        "embedded_statement",
        "narrator_interpretation",
        "later_commentary",
        "modern_inference",
        "unspecified"
      ]
    },
    "date_disputes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "occurrence_time": {
      "type": [
        "string",
        "null"
      ],
      "description": "When the historical event occurred; may be uncertain, not automatically patent priority date"
    },
    "record_time": {
      "type": [
        "string",
        "null"
      ],
      "description": "When the underlying document or filing was created"
    },
    "disclosure_time": {
      "type": [
        "string",
        "null"
      ],
      "description": "When information became publicly available, if evidenced"
    },
    "historian_scope_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Chosen narrative scope identifier, separate from occurrence/record/disclosure"
    },
    "historian_alternative_scope_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missingness_type": {
      "enum": [
        "none",
        "not_observed",
        "source_lost",
        "date_unknown",
        "not_public",
        "not_applicable",
        "zero_observed",
        "no_patent_filed"
      ]
    }
  }
}
